
func main() {
    print("Запуск калькулятора...")
    
    var win = guiWindow("Arx Calculator", 300, 400)
    var display = guiTextBox(10, 10, 260, 40)
    guiAdd(win, display)
    
    // Ми поки не маємо повноцінної підтримки колбеків через події, 
    // тому зробимо консольний калькулятор, але з GUI вікном як "заглушкою" 
    // або просто покажемо вікно.
    
    var btn1 = guiButton("1", 10, 60, 50, 50)
    var btn2 = guiButton("2", 70, 60, 50, 50)
    var btn3 = guiButton("3", 130, 60, 50, 50)
    var btnPlus = guiButton("+", 190, 60, 50, 50)
    
    guiAdd(win, btn1)
    guiAdd(win, btn2)
    guiAdd(win, btn3)
    guiAdd(win, btnPlus)
    
    print("Вікно створено. Показую...")
    guiShow(win)
}
