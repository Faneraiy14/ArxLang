// Вгадай число — версія з рівнями складності.
//
// Що виправлено проти першого варіанта:
//   * межі рівня зберігаються у змінних, а не дублюються в кожній гілці —
//     раніше randomInt і текст підказки писались тричі майже однаково;
//   * загадане число більше не генерується двічі (спершу в main, потім у
//     гілці) — зайвий randomInt на початку прибрано;
//   * підказка "більше/менше" тепер з погляду ГРАВЦЯ: якщо його число
//     завелике, він має вводити менше;
//   * додано лічильник спроб і оптимальну кількість для порівняння.

func опис(рівень) {
    if рівень == 1 {
        return "Легкий: показує різницю, число від 1 до 50"
    } else if рівень == 2 {
        return "Середній: тільки більше/менше, число від 1 до 100"
    }
    return "Складний: без підказок, число від 1 до 200"
}

func межа(рівень) {
    if рівень == 1 {
        return 50
    } else if рівень == 2 {
        return 100
    }
    return 200
}

// Скільки спроб потрібно ідеальній стратегії (діленню навпіл) у найгіршому
// випадку: найменше k, за якого 2^k >= межа. Рахуємо подвоєнням, а не
// діленням: ділення в NyxilumLang дробове, і лічильник накручував зайвий крок.
func оптимум(межа) {
    var кроків = 0
    var діапазон = 1
    while діапазон < межа {
        діапазон = діапазон * 2
        кроків = кроків + 1
    }
    return кроків
}

func підказка(загадане, введене, рівень) {
    if рівень == 3 {
        return "Не те. Спробуй ще."
    }

    if введене > загадане {
        if рівень == 1 {
            return "Забагато на " + (введене - загадане) + ". Бери менше."
        }
        return "Забагато. Бери менше."
    }

    if рівень == 1 {
        return "Замало на " + (загадане - введене) + ". Бери більше."
    }
    return "Замало. Бери більше."
}

func грати(рівень) {
    var верх = межа(рівень)
    var загадане = randomInt(1, верх)
    var спроби = 0

    print("")
    print("Вгадай число від 1 до " + верх + ".")

    while true {
        var введене = readInt()
        спроби = спроби + 1

        if введене < 1 || введене > верх {
            print("Число має бути від 1 до " + верх + ". Ця спроба не рахується.")
            спроби = спроби - 1
        } else if введене == загадане {
            print("")
            print("Вгадав! Число було " + загадане + ".")
            print("Спроб: " + спроби + ". Оптимально можна було за " + оптимум(верх) + ".")
            break
        } else {
            print(підказка(загадане, введене, рівень))
        }
    }
}

func main() {
    print("=== Вгадай число ===")
    print("")
    print("1 - " + опис(1))
    print("2 - " + опис(2))
    print("3 - " + опис(3))
    print("")
    print("Обери рівень:")

    var рівень = readInt()

    if рівень != 1 && рівень != 2 && рівень != 3 {
        print("Такого рівня немає. Граємо на середньому.")
        рівень = 2
    }

    грати(рівень)
}
