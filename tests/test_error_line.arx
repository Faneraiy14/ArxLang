// Перевірка: Runtime Error тепер показує номер рядка джерела, а не
// лише текст помилки. Обгорнуто в try/catch, щоб цей тест сам не
// провалював run_all.sh — перевіряємо повідомлення помилки через toString(e).
func main() {
    var caught = ""
    try {
        var arr = [1, 2, 3]
        var x = arr[99]
    } catch (e) {
        caught = toString(e)
    }
    print("Спіймано: " + caught)

    if contains(caught, "рядок") {
        print("Номер рядка присутній у повідомленні: OK")
    } else {
        print("ПОМИЛКА: номер рядка відсутній у повідомленні")
    }
}
