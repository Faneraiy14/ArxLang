// Неформальний бенчмарк: порівняти час виконання гарячого числового
// циклу з ARX_JIT=1 (типово) і ARX_JIT=0. Не частина run_all.sh (немає
// фіксованого порогу проходження — швидкість залежить від машини),
// запускається вручну для демонстрації приросту.
func main() {
    var start = timestamp()
    var sum = 0
    var i = 0
    while i < 20000000 {
        sum = sum + i
        i = i + 1
    }
    var elapsed = timestamp() - start
    print("sum = " + toString(sum))
    print("elapsed(s) = " + toString(elapsed))
}
