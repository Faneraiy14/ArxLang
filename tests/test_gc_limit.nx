// Перевірка ліміту GC: gc_limit(N) має зупинити некерований цикл виділень
// через try/catch, а не впасти "сирою" помилкою процесу.
struct Item {
    n: i32
}

func main() {
    gc_limit(50)

    try {
        var i = 0
        while i < 100000 {
            var item = Item { n: i }
            i = i + 1
        }
        print("не мало дійти сюди — ліміт мав спрацювати раніше")
    } catch (e) {
        print("Спіймано очікувану помилку ліміту: " + toString(len(e) > 0))
    }

    print("Програма завершилась нормально після ліміту GC")
}
