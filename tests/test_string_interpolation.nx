import "../lib/testing.nx" { assertEqual }

func подвоїти(x) {
    return x * 2
}

func main() {
    var імя = "Світ"
    var число = 42

    assertEqual("Привіт, ${імя}!", "Привіт, Світ!", "проста інтерполяція змінної")
    assertEqual("${число}", "42", "весь рядок — сама інтерполяція, без тексту навколо")
    assertEqual("${число * 2}", "84", "вираз усередині інтерполяції")
    assertEqual("${подвоїти(число)}", "84", "виклик функції всередині інтерполяції")
    assertEqual("a${1}b${2}c", "a1b2c", "кілька інтерполяцій підряд")
    assertEqual("нема \${тексту}", "нема \${тексту}", "\\$ екранує $ — не інтерполяція")
    assertEqual("${null}", "null", "null у інтерполяції друкується як null")
    assertEqual("${""}", "", "порожній рядок у інтерполяції")
    assertEqual("вкладено: ${1 + (2 * 3)}", "вкладено: 7", "дужки й пріоритет операцій усередині виразу")

    var mp = newMap()
    mapSet(mp, "x", 5)
    assertEqual("x=${mapGet(mp, "x")}", "x=5", "рядковий літерал усередині інтерполяції не ламає межу фігурних дужок")

    print("усі перевірки string interpolation пройдено")
}
