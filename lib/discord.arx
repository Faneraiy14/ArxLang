// lib/discord.arx — мінімальний Discord Gateway-клієнт чистою ArxLang.
// На відміну від lib/telegram.arx (де досить HTTPS+JSON), Discord вимагає
// постійне WebSocket-з'єднання (Gateway) для отримання подій у реальному
// часі - тому цей модуль з'явився лише ПІСЛЯ додавання нативних
// wsConnect/wsSend/wsReceive/wsClose у VirtualMachine. Надсилання
// повідомлень - звичайний httpRequest з заголовком Authorization (REST),
// саме тому httpRequest отримав 4-й опційний параметр headers.
//
// intents - бітова маска (https://discord.com/developers/docs/topics/gateway#gateway-intents),
// напр. 37377 = GUILDS (1) + GUILD_MESSAGES (512) + DIRECT_MESSAGES (4096)
// + MESSAGE_CONTENT (32768) - остання потрібна для DM-повідомлень боту.
// Не забудь увімкнути "Message Content Intent" у Discord Developer Portal -
// без нього d.content у MESSAGE_CREATE завжди порожній.

func dSendMessage(token, channelId, text) {
    var data = newMap()
    mapSet(data, "content", text)

    var headers = newMap()
    mapSet(headers, "Authorization", "Bot " + token)

    var url = "https://discord.com/api/v10/channels/" + toString(channelId) + "/messages"
    var res = httpRequest(url, "POST", toJson(data), headers)
    return fromJson(mapGet(res, "body"))
}

func _dIdentify(ws, token, intents) {
    var properties = newMap()
    mapSet(properties, "os", "linux")
    mapSet(properties, "browser", "arxlang")
    mapSet(properties, "device", "arxlang")

    var d = newMap()
    mapSet(d, "token", token)
    mapSet(d, "intents", intents)
    mapSet(d, "properties", properties)

    var payload = newMap()
    mapSet(payload, "op", 2)
    mapSet(payload, "d", d)
    wsSend(ws, toJson(payload))
}

func _dHeartbeat(ws, sequence) {
    var payload = newMap()
    mapSet(payload, "op", 1)
    mapSet(payload, "d", sequence)
    wsSend(ws, toJson(payload))
}

// handler(eventName, data) викликається на кожну Dispatch-подію (op:0),
// наприклад handler("MESSAGE_CREATE", d) - d.content, d.channel_id тощо.
// Блокує назавжди (як httpServer/tgPollLoop). Heartbeat надсилається сам,
// за розкладом, який Discord повідомляє у Hello (op:10) - викликачу
// думати про це не треба.
func dPollLoop(token, intents, handler) {
    var ws = wsConnect("wss://gateway.discord.gg/?v=10&encoding=json")
    var heartbeatInterval = 0
    var lastHeartbeat = timestamp()
    var sequence = null
    var closed = false

    // wsReceive кидає (не повертає null), коли з'єднання РОЗІРВАНЕ сервером
    // (напр. 4004 - невірний токен, побачив це вживу при перевірці) - на
    // відміну від тайм-ауту (null), який означає лише "поки нічого нового".
    // Без try/catch тут ця помилка вилетіла б з dPollLoop і впала процесом,
    // замість чіткого повідомлення й акуратного виходу з циклу.
    while !closed {
        try {
            var raw = wsReceive(ws, 5000)

            if !isNull(raw) {
                var msg = fromJson(raw)
                var op = mapGet(msg, "op")
                var s = mapGet(msg, "s")
                if !isNull(s) {
                    sequence = s
                }

                if op == 10 {
                    var d = mapGet(msg, "d")
                    heartbeatInterval = mapGet(d, "heartbeat_interval")
                    lastHeartbeat = timestamp()
                    _dIdentify(ws, token, intents)
                } else if op == 1 {
                    _dHeartbeat(ws, sequence)
                    lastHeartbeat = timestamp()
                } else if op == 7 {
                    print("[discord] сервер попросив reconnect - dPollLoop поки не вміє resume, перезапусти бота")
                } else if op == 9 {
                    print("[discord] невалідна сесія - перевір токен і чи увімкнені потрібні intents у Developer Portal")
                } else if op == 0 {
                    handler(mapGet(msg, "t"), mapGet(msg, "d"))
                }
            }

            if heartbeatInterval > 0 {
                var elapsedMs = (timestamp() - lastHeartbeat) * 1000
                if elapsedMs >= heartbeatInterval {
                    _dHeartbeat(ws, sequence)
                    lastHeartbeat = timestamp()
                }
            }
        } catch (e) {
            print("[discord] з'єднання закрито: " + e)
            closed = true
        }
    }

    wsClose(ws)
}
