// Convert.ToInt32() у C# округлює до найближчого ЦІЛОГО за банківським
// правилом (round half to even): 5.9->6, 5.5->6, АЛЕ 4.5->4, 2.5->2.
// Для toInt(), індексів масиву, substring, removeAt/insert очікується
// звичайне ВІДКИДАННЯ дробової частини (як (int) у C/C#, parseInt у JS).
// Виправлено через окремий хелпер TruncToInt (відкидання) замість
// Convert.ToInt32 (банківське округлення) на всіх відповідних місцях.

func main() {
    print("1. toInt() відкидає дробову частину, не округлює")
    if toInt(5.9) == 5 { print("  ок") } else { print("  ПРОВАЛ") }
    if toInt(5.5) == 5 { print("  ок") } else { print("  ПРОВАЛ") }
    if toInt(4.5) == 4 { print("  ок") } else { print("  ПРОВАЛ") }
    if toInt(2.5) == 2 { print("  ок") } else { print("  ПРОВАЛ") }
    if toInt(3.5) == 3 { print("  ок") } else { print("  ПРОВАЛ") }

    print("2. toInt() з від'ємними — теж відкидання, не округлення до -inf")
    if toInt(-5.9) == -5 { print("  ок") } else { print("  ПРОВАЛ") }
    if toInt(-5.5) == -5 { print("  ок") } else { print("  ПРОВАЛ") }

    print("3. індексація масиву дробовим значенням відкидає дріб")
    var arr = [10, 20, 30, 40]
    if arr[toInt(2.9)] == 30 { print("  ок") } else { print("  ПРОВАЛ") }

    print("4. substring з дробовою довжиною/початком")
    var s = "abcdef"
    if substring(s, toInt(1.9), toInt(2.9)) == "bc" { print("  ок") } else { print("  ПРОВАЛ") }

    print("5. removeAt/insert з дробовим індексом")
    var lst = [1, 2, 3, 4]
    removeAt(lst, toInt(1.9))
    if lst[1] == 3 { print("  ок") } else { print("  ПРОВАЛ") }
    insert(lst, toInt(0.9), 99)
    if lst[0] == 99 { print("  ок") } else { print("  ПРОВАЛ") }

    print("ГОТОВО")
}

main()
