// Виклик результату виклику напряму, без проміжної змінної: f()(), mk(1)(2),
// arr[0](), map()["f"](). Раніше парсер кидав "Виклик функції можливий лише
// для ідентифікаторів" - будь-що складніше за var f = mk(); f() не парсилось.

func mk() {
    return func() { return 42 }
}

func adder(x) {
    return func(y) { return x + y }
}

func main() {
    print("1. f()()")
    if mk()() == 42 { print("  ок") } else { print("  ПРОВАЛ") }

    print("2. виклик з аргументом у обох дужках: adder(10)(5)")
    if adder(10)(5) == 15 { print("  ок") } else { print("  ПРОВАЛ") }

    print("3. проміжна змінна досі працює (старий шлях не зламано)")
    var f = mk()
    if f() == 42 { print("  ок") } else { print("  ПРОВАЛ") }

    print("4. виклик значення з масиву без проміжної змінної")
    var arr = [mk(), adder(1)]
    if arr[0]() == 42 { print("  ок") } else { print("  ПРОВАЛ") }
    if arr[1](9) == 10 { print("  ок") } else { print("  ПРОВАЛ") }

    print("5. троє викликів підряд (лямбда, що повертає лямбду)")
    var triple = func() {
        return func() { return 100 }
    }
    if triple()() == 100 { print("  ок") } else { print("  ПРОВАЛ") }

    print("ГОТОВО")
}
