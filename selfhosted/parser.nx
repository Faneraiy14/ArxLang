// ============================================================
// PARSER — рекурсивний спуск, будує AST як мапи (вузол = мапа з полем "type").
// Стан парсера ({tokens, pos}) - мапа (посилальний тип), тому функції
// діляться й оновлюють позицію без явного повернення нового стану.
// ============================================================

func makeParserState(tokens) {
    var state = newMap()
    mapSet(state, "tokens", tokens)
    mapSet(state, "pos", 0)
    return state
}

func peek(state) {
    var tokens = mapGet(state, "tokens")
    return tokens[mapGet(state, "pos")]
}

func advanceTok(state) {
    var tok = peek(state)
    mapSet(state, "pos", mapGet(state, "pos") + 1)
    return tok
}

func checkType(state, type_) {
    return mapGet(peek(state), "type") == type_
}

func checkValue(state, value) {
    return mapGet(peek(state), "value") == value
}

func makeNode(type_) {
    var n = newMap()
    mapSet(n, "type", type_)
    return n
}

// ===== ВИРАЗИ =====

func parsePrimary(state) {
    var tok = peek(state)
    var t = mapGet(tok, "type")
    var v = mapGet(tok, "value")

    if t == "NUMBER" {
        advanceTok(state)
        var n = makeNode("Literal")
        mapSet(n, "value", toDouble(v))
        return parsePostfix(state, n)
    }
    if t == "STRING" {
        advanceTok(state)
        var n = makeNode("Literal")
        mapSet(n, "value", v)
        return parsePostfix(state, n)
    }
    if t == "KEYWORD" && (v == "true" || v == "false") {
        advanceTok(state)
        var n = makeNode("Literal")
        mapSet(n, "value", v == "true")
        return parsePostfix(state, n)
    }
    if t == "KEYWORD" && v == "null" {
        advanceTok(state)
        var n = makeNode("Literal")
        mapSet(n, "value", null)
        return parsePostfix(state, n)
    }
    if t == "KEYWORD" && v == "func" {
        // Анонімна функція (лямбда): func(a, b) { ... }
        advanceTok(state)
        advanceTok(state) // (
        var params = []
        while !checkValue(state, ")") {
            append(params, mapGet(advanceTok(state), "value"))
            if checkValue(state, ",") {
                advanceTok(state)
            }
        }
        advanceTok(state) // )
        var body = parseBlock(state)
        var n = makeNode("FunctionExpr")
        mapSet(n, "params", params)
        mapSet(n, "body", body)
        return parsePostfix(state, n)
    }
    if checkValue(state, "[") {
        advanceTok(state)
        var elements = []
        while !checkValue(state, "]") {
            append(elements, parseExpr(state))
            if checkValue(state, ",") {
                advanceTok(state)
            }
        }
        advanceTok(state) // ]
        var n = makeNode("ArrayLiteral")
        mapSet(n, "elements", elements)
        return parsePostfix(state, n)
    }
    if t == "IDENT" {
        advanceTok(state)
        // StructInit: Ім'я (з великої літери) { поле: значення, ... }
        var first = substring(v, 0, 1)
        if first == toUpper(first) && charCode(first) >= 65 && charCode(first) <= 90 && checkValue(state, "{") {
            advanceTok(state) // {
            var fields = []
            while !checkValue(state, "}") {
                var fname = mapGet(advanceTok(state), "value")
                advanceTok(state) // :
                var fvalue = parseExpr(state)
                var fnode = newMap()
                mapSet(fnode, "name", fname)
                mapSet(fnode, "value", fvalue)
                append(fields, fnode)
                if checkValue(state, ",") {
                    advanceTok(state)
                }
            }
            advanceTok(state) // }
            var sn = makeNode("StructInit")
            mapSet(sn, "structName", v)
            mapSet(sn, "fields", fields)
            return parsePostfix(state, sn)
        }
        if checkValue(state, "(") {
            advanceTok(state)
            var args = []
            while !checkValue(state, ")") {
                append(args, parseExpr(state))
                if checkValue(state, ",") {
                    advanceTok(state)
                }
            }
            advanceTok(state)
            var cn = makeNode("Call")
            mapSet(cn, "name", v)
            mapSet(cn, "args", args)
            return parsePostfix(state, cn)
        }
        var varNode = makeNode("Var")
        mapSet(varNode, "name", v)
        return parsePostfix(state, varNode)
    }
    if t == "KEYWORD" && v == "self" {
        advanceTok(state)
        var n = makeNode("Var")
        mapSet(n, "name", "self")
        return parsePostfix(state, n)
    }
    if checkValue(state, "(") {
        advanceTok(state)
        var inner = parseExpr(state)
        advanceTok(state)
        return parsePostfix(state, inner)
    }
    throw "Неочікуваний токен у виразі: " + t + " '" + v + "'"
}

// Обробляє послідовні .field / [index] / (args) після первинного виразу
func parsePostfix(state, expr) {
    var current = expr
    var more = true
    while more {
        more = false
        if checkValue(state, ".") {
            advanceTok(state)
            var name = mapGet(advanceTok(state), "value")
            if checkValue(state, "(") {
                advanceTok(state)
                var args = []
                while !checkValue(state, ")") {
                    append(args, parseExpr(state))
                    if checkValue(state, ",") {
                        advanceTok(state)
                    }
                }
                advanceTok(state)
                var mc = makeNode("MethodCall")
                mapSet(mc, "obj", current)
                mapSet(mc, "method", name)
                mapSet(mc, "args", args)
                current = mc
            } else {
                var mem = makeNode("Member")
                mapSet(mem, "obj", current)
                mapSet(mem, "field", name)
                current = mem
            }
            more = true
        } else if checkValue(state, "[") {
            advanceTok(state)
            var idx = parseExpr(state)
            advanceTok(state) // ]
            var ix = makeNode("Index")
            mapSet(ix, "arr", current)
            mapSet(ix, "index", idx)
            current = ix
            more = true
        }
    }
    return current
}

func parseUnary(state) {
    if checkValue(state, "!") || checkValue(state, "-") {
        var op = mapGet(advanceTok(state), "value")
        var operand = parseUnary(state)
        var n = makeNode("Unary")
        mapSet(n, "op", op)
        mapSet(n, "operand", operand)
        return n
    }
    return parsePrimary(state)
}

func parseBinaryLevel(state, ops, next) {
    var left = next(state)
    var found = true
    while found {
        found = false
        for op in ops {
            if checkValue(state, op) {
                advanceTok(state)
                var right = next(state)
                var n = makeNode("Binary")
                mapSet(n, "op", op)
                mapSet(n, "left", left)
                mapSet(n, "right", right)
                left = n
                found = true
            }
        }
    }
    return left
}

func parseMul(state) { return parseBinaryLevel(state, ["*", "/", "%"], parseUnary) }
func parseAdd(state) { return parseBinaryLevel(state, ["+", "-"], parseMul) }
func parseComparison(state) { return parseBinaryLevel(state, ["<", "<=", ">", ">="], parseAdd) }
func parseEquality(state) { return parseBinaryLevel(state, ["==", "!="], parseComparison) }
func parseAnd(state) { return parseBinaryLevel(state, ["&&"], parseEquality) }
func parseOr(state) { return parseBinaryLevel(state, ["||"], parseAnd) }

func isAssignTarget(node) {
    var t = mapGet(node, "type")
    return t == "Var" || t == "Index" || t == "Member"
}

func parseExpr(state) {
    var left = parseOr(state)
    if checkValue(state, "=") && isAssignTarget(left) {
        advanceTok(state)
        var value = parseExpr(state)
        var n = makeNode("Assign")
        mapSet(n, "target", left)
        mapSet(n, "value", value)
        return n
    }
    return left
}

// ===== ОПЕРАТОРИ =====

func parseBlock(state) {
    advanceTok(state) // {
    var stmts = []
    while !checkValue(state, "}") {
        append(stmts, parseStatement(state))
    }
    advanceTok(state) // }
    return stmts
}

func parseParamList(state) {
    advanceTok(state) // (
    var params = []
    while !checkValue(state, ")") {
        append(params, mapGet(advanceTok(state), "value"))
        if checkValue(state, ",") {
            advanceTok(state)
        }
    }
    advanceTok(state) // )
    return params
}

func parseFuncDecl(state) {
    advanceTok(state) // func
    var name = mapGet(advanceTok(state), "value")
    var structName = null
    if checkValue(state, ".") {
        advanceTok(state)
        structName = name
        name = mapGet(advanceTok(state), "value")
    }
    var params = parseParamList(state)
    if structName != null {
        var selfParams = ["self"]
        for p in params {
            append(selfParams, p)
        }
        params = selfParams
    }
    var body = parseBlock(state)
    var n = makeNode("FuncDecl")
    mapSet(n, "name", name)
    mapSet(n, "structName", structName)
    mapSet(n, "params", params)
    mapSet(n, "body", body)
    return n
}

func parseStructDecl(state) {
    // Методи структури НЕ вкладаються в блок struct - вони оголошуються
    // окремо, як func StructName.method() { ... }, так само як у справжній
    // NyxilumLang (GUIDE.md). Тут парситься лише список полів.
    advanceTok(state) // struct
    var name = mapGet(advanceTok(state), "value")
    advanceTok(state) // {
    var fields = []
    while !checkValue(state, "}") {
        append(fields, mapGet(advanceTok(state), "value"))
        if checkValue(state, ",") {
            advanceTok(state)
        }
    }
    advanceTok(state) // }
    var n = makeNode("StructDecl")
    mapSet(n, "name", name)
    mapSet(n, "fields", fields)
    return n
}

func parseStatement(state) {
    var tok = peek(state)
    var t = mapGet(tok, "type")
    var v = mapGet(tok, "value")

    if t == "KEYWORD" && v == "var" {
        advanceTok(state)
        var name = mapGet(advanceTok(state), "value")
        advanceTok(state) // =
        var init = parseExpr(state)
        var n = makeNode("VarDecl")
        mapSet(n, "name", name)
        mapSet(n, "init", init)
        return n
    }
    if t == "KEYWORD" && v == "if" {
        advanceTok(state)
        advanceTok(state) // (
        var cond = parseExpr(state)
        advanceTok(state) // )
        var thenBlock = parseBlock(state)
        var elseBlock = []
        if checkType(state, "KEYWORD") && checkValue(state, "else") {
            advanceTok(state)
            elseBlock = parseBlock(state)
        }
        var n = makeNode("If")
        mapSet(n, "cond", cond)
        mapSet(n, "then", thenBlock)
        mapSet(n, "else", elseBlock)
        return n
    }
    if t == "KEYWORD" && v == "while" {
        advanceTok(state)
        advanceTok(state) // (
        var cond = parseExpr(state)
        advanceTok(state) // )
        var body = parseBlock(state)
        var n = makeNode("While")
        mapSet(n, "cond", cond)
        mapSet(n, "body", body)
        return n
    }
    if t == "KEYWORD" && v == "for" {
        advanceTok(state)
        var varName = mapGet(advanceTok(state), "value")
        advanceTok(state) // in
        var start = parseAdd(state)
        if checkValue(state, "..") {
            advanceTok(state)
            var end = parseAdd(state)
            var body = parseBlock(state)
            var n = makeNode("ForRange")
            mapSet(n, "varName", varName)
            mapSet(n, "start", start)
            mapSet(n, "end", end)
            mapSet(n, "body", body)
            return n
        }
        var feBody = parseBlock(state)
        var fn = makeNode("ForEach")
        mapSet(fn, "varName", varName)
        mapSet(fn, "arrExpr", start)
        mapSet(fn, "body", feBody)
        return fn
    }
    if t == "KEYWORD" && v == "func" {
        return parseFuncDecl(state)
    }
    if t == "KEYWORD" && v == "struct" {
        return parseStructDecl(state)
    }
    if t == "KEYWORD" && v == "return" {
        advanceTok(state)
        var n = makeNode("Return")
        // "return" без значення: далі йде "}" (кінець блоку) або кінець файлу.
        // Раніше parseExpr натикався на "}" і валив увесь розбір.
        if checkValue(state, "}") || checkType(state, "EOF") {
            mapSet(n, "value", makeNode("Literal"))
            mapSet(mapGet(n, "value"), "value", null)
            return n
        }
        mapSet(n, "value", parseExpr(state))
        return n
    }
    if t == "KEYWORD" && v == "print" {
        advanceTok(state)
        advanceTok(state) // (
        var value = parseExpr(state)
        advanceTok(state) // )
        var n = makeNode("Print")
        mapSet(n, "value", value)
        return n
    }

    var expr = parseExpr(state)
    var n = makeNode("ExprStmt")
    mapSet(n, "expr", expr)
    return n
}

func parseProgram(tokens) {
    var state = makeParserState(tokens)
    var stmts = []
    while !checkType(state, "EOF") {
        append(stmts, parseStatement(state))
    }
    return stmts
}
