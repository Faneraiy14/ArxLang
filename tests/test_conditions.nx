// Умови в різних формах запису — з дужками, без них і зі складними виразами,
// що ПОЧИНАЮТЬСЯ з дужки (раніше такі ламали парсер).

func main() {
    var a = 5
    var b = 10

    print("1. без дужок")
    if a < b { print("  ок") }

    print("2. у дужках")
    if (a < b) { print("  ок") }

    print("3. умова починається з дужки, але нею не вичерпується")
    if (a > 0) && (b > 0) { print("  ок") }

    print("4. те саме з ||")
    if (a > 100) || (b == 10) { print("  ок") }

    print("5. три групи")
    if (a == 5) && (b == 10) && (a < b) { print("  ок") }

    print("6. while з дужками на початку")
    var i = 0
    while (i < 3) && (i >= 0) {
        print("  i=" + i)
        i = i + 1
    }

    print("7. while без дужок")
    var j = 0
    while j < 2 {
        print("  j=" + j)
        j = j + 1
    }

    print("8. вкладені дужки")
    if ((a + b) > 10) { print("  ок") }

    print("9. else if")
    if a > 100 {
        print("  гілка 1")
    } else if (a == 5) {
        print("  гілка 2 — правильна")
    } else {
        print("  гілка 3")
    }

    print("ГОТОВО")
}
