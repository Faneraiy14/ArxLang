import "../lib/collections.arx" { range, rangeFrom, sum, first, last, flatten, zip, chunk, count }
import "../lib/testing.arx" { assertEqual, assertThrows }

func main() {
    assertEqual(len(range(5)), 5, "range(5) має 5 елементів")
    assertEqual(range(3)[0], 0, "range(3) починається з 0")
    assertEqual(range(3)[2], 2, "range(3) закінчується на n-1")

    assertEqual(len(rangeFrom(2, 5)), 3, "rangeFrom(2,5) має 3 елементи")
    assertEqual(rangeFrom(2, 5)[0], 2, "rangeFrom(2,5) починається з 2")

    assertEqual(sum([1, 2, 3, 4]), 10, "sum масиву чисел")

    assertEqual(first([10, 20, 30]), 10, "first повертає перший елемент")
    assertEqual(last([10, 20, 30]), 30, "last повертає останній елемент")
    assertThrows(func() { first([]) }, "first на пустому масиві має кинути помилку")

    var flat = flatten([1, [2, 3], 4])
    assertEqual(len(flat), 4, "flatten розгортає один рівень")
    assertEqual(flat[1], 2, "flatten зберігає порядок елементів")

    var zipped = zip([1, 2, 3], ["a", "b"])
    assertEqual(len(zipped), 2, "zip обрізає до коротшого масиву")
    assertEqual(zipped[0][0], 1, "zip зберігає перший елемент пари")
    assertEqual(zipped[0][1], "a", "zip зберігає другий елемент пари")

    var chunks = chunk([1, 2, 3, 4, 5], 2)
    assertEqual(len(chunks), 3, "chunk по 2 з 5 елементів дає 3 групи")
    assertEqual(len(chunks[2]), 1, "остання група chunk коротша")

    var isEven = func(x) { return x % 2 == 0 }
    assertEqual(count([1, 2, 3, 4, 5, 6], isEven), 3, "count рахує елементи за предикатом")

    print("усі перевірки lib/collections.arx пройдено")
}
