import "../lib/testing.arx" { assertEqual, assertTrue, assertFalse, assertThrows }

func main() {
    assertEqual(2 + 2, 4, "2+2 має дорівнювати 4")
    assertTrue(true, "true має бути true")
    assertFalse(false, "false має бути false")

    assertThrows(func() {
        throw "навмисна помилка"
    }, "функція мала кинути помилку")

    print("усі перевірки пройдено")
}
