// lib/collections.arx — утиліти над масивами понад вбудовані sort/mapArr/
// filter/reduce/slice/unique (у дусі Python itertools / lodash).

func range(n) {
    var result = []
    var i = 0
    while i < n {
        append(result, i)
        i = i + 1
    }
    return result
}

func rangeFrom(start, end) {
    var result = []
    var i = start
    while i < end {
        append(result, i)
        i = i + 1
    }
    return result
}

func sum(arr) {
    var total = 0
    var i = 0
    while i < len(arr) {
        total = total + arr[i]
        i = i + 1
    }
    return total
}

func first(arr) {
    if len(arr) == 0 {
        throw "first(): масив порожній"
    }
    return arr[0]
}

func last(arr) {
    if len(arr) == 0 {
        throw "last(): масив порожній"
    }
    return arr[len(arr) - 1]
}

// Розгортає лише ОДИН рівень вкладеності: flatten([1, [2, 3], 4]) -> [1,2,3,4],
// але flatten([1, [2, [3]]]) -> [1, 2, [3]] (внутрішній масив лишається).
func flatten(arr) {
    var result = []
    var i = 0
    while i < len(arr) {
        var item = arr[i]
        if isArray(item) {
            var j = 0
            while j < len(item) {
                append(result, item[j])
                j = j + 1
            }
        } else {
            append(result, item)
        }
        i = i + 1
    }
    return result
}

// Довжина результату = коротший з двох масивів (як Python zip, не padding).
func zip(arr1, arr2) {
    var result = []
    var n = min(len(arr1), len(arr2))
    var i = 0
    while i < n {
        append(result, [arr1[i], arr2[i]])
        i = i + 1
    }
    return result
}

func chunk(arr, size) {
    var result = []
    var i = 0
    while i < len(arr) {
        append(result, slice(arr, i, min(i + size, len(arr))))
        i = i + size
    }
    return result
}

// fn(item) -> bool; рахує елементи, для яких fn повернула true.
func count(arr, fn) {
    var total = 0
    var i = 0
    while i < len(arr) {
        if fn(arr[i]) {
            total = total + 1
        }
        i = i + 1
    }
    return total
}
