func main() {
    var canvas = createCanvas("NyxilumLang 2D Test", 400, 300)
    var x = 50
    var frame = 0

    while frame < 60 {
        clearCanvas(canvas, 20, 20, 30)
        drawRect(canvas, x, 100, 40, 40, 200, 60, 60)
        drawCircle(canvas, 300, 150, 25, 60, 200, 60)
        drawLine(canvas, 0, 250, 400, 250, 255, 255, 255)
        drawText(canvas, "Frame " + toString(frame), 10, 10, 14, 255, 255, 255)
        presentCanvas(canvas)

        x = x + 3
        frame = frame + 1
    }

    print("2D графіка: 60 кадрів відмальовано без помилок")
    closeCanvas(canvas)
}
