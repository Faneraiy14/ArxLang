// Перевірка обліку ArxLang-виділень: gc_stats() має показувати зростання
// лічильника allocated після циклу виділень структур/масивів.
struct Point {
    x: i32
    y: i32
}

func main() {
    var before = gc_stats()
    print("До: allocated=" + toString(before.allocated))

    var i = 0
    while i < 500 {
        var p = Point { x: i, y: i * 2 }
        var arr = [p.x, p.y]
        i = i + 1
    }

    var after = gc_stats()
    print("Після: allocated=" + toString(after.allocated))

    if after.allocated > before.allocated {
        print("gc_stats: лічильник зріс, OK")
    } else {
        print("gc_stats: лічильник НЕ зріс, помилка")
    }

    gc_collect()
    print("gc_collect викликано без падіння")
}
