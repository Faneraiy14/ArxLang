// Регресія: вибірковий import публічної функції має тягнути й приватні
// хелпери модуля (ім'я на "_"), навіть якщо їх не перелічено явно -
// інакше публічна функція, що викликає такий хелпер, впаде з "не
// оголошена" (знайдено на lib/discord.arx: dPollLoop -> _dIdentify).
import "modules/lib_private_helper.arx" { publicFn }

func main() {
    print(publicFn(5))   // (5*2)+1 = 11
}
