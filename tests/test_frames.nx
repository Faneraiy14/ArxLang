func countdown(n) {
    var original = n
    if n > 0 {
        countdown(n - 1)
    }
    print("на рівні " + toString(n) + " original = " + toString(original))
}

func main() {
    countdown(3)
    print("---")
    print(factorial(5))
}

func factorial(n) {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}
