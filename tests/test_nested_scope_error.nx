// Підтверджує, що вкладена функція НЕ видима поза межами свого "батька" —
// раніше (плаский спільний простір імен) цей виклик спрацював би.
// Помилка тут — ОЧІКУВАНИЙ результат (див. EXPECT_ERROR у run_all.sh).

func container() {
    func helper() {
        return "не мало б бути видно ззовні"
    }
    return helper()
}

func main() {
    container()
    print(helper())
}
main()
