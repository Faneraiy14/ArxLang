// Перевірка break і continue в усіх трьох видах циклів, включно з вкладеними.

func main() {
    print("1. while + break (очікується 0 1 2)")
    var i = 0
    while i < 100 {
        if i == 3 { break }
        print(i)
        i = i + 1
    }

    print("2. while + continue (очікується 1 3 5, непарні до 6)")
    var j = 0
    while j < 6 {
        j = j + 1
        if j % 2 == 0 { continue }
        print(j)
    }

    print("3. for range + break (очікується 0 1 2)")
    for k in 0..100 {
        if k == 3 { break }
        print(k)
    }

    print("4. for range + continue (очікується 0 1 3 4, без 2)")
    for m in 0..5 {
        if m == 2 { continue }
        print(m)
    }

    print("5. for in масив + break (очікується 10 20)")
    var arr = [10, 20, 30, 40]
    for x in arr {
        if x == 30 { break }
        print(x)
    }

    print("6. for in масив + continue (очікується 10 30 40, без 20)")
    for y in arr {
        if y == 20 { continue }
        print(y)
    }

    print("7. вкладені цикли: break виходить лише з внутрішнього")
    print("   очікується: 0-0 0-1 1-0 1-1 2-0 2-1")
    for a in 0..3 {
        for b in 0..10 {
            if b == 2 { break }
            print("   " + a + "-" + b)
        }
    }

    print("8. continue у зовнішньому циклі при вкладеному")
    print("   очікується: зовн 0 / вн 0-0 / зовн 2 / вн 2-0")
    for p in 0..3 {
        if p == 1 { continue }
        print("   зовн " + p)
        for q in 0..1 {
            print("   вн " + p + "-" + q)
        }
    }

    print("9. break у while всередині for")
    print("   очікується: пара 0 / пара 1")
    for r in 0..2 {
        var s = 0
        while true {
            if s == 1 { break }
            print("   пара " + r)
            s = s + 1
        }
    }

    print("ГОТОВО")
}
