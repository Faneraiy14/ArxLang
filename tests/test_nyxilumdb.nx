// Перевірка stdlib-обгортки навколо NyxilumDb: dbOpen/dbSet/dbGet/dbHas/
// dbDelete/dbKeys/dbCount/dbClose. Значення v1 — лише рядки.
func main() {
    var db = dbOpen("test_nyxilumdb_data")

    dbSet(db, "greeting", "Привіт з NyxilumLang!")
    dbSet(db, "user:1", "Святослав")
    dbSet(db, "user:2", "Аліна")

    print("typeOf(db) = " + typeOf(db))
    print("greeting = " + dbGet(db, "greeting"))
    print("dbHas user:1 = " + toString(dbHas(db, "user:1")))
    print("dbCount = " + toString(dbCount(db)))

    var keys = dbKeys(db, "user:")
    print("user: keys count = " + toString(len(keys)))

    dbDelete(db, "user:2")
    print("dbHas user:2 after delete = " + toString(dbHas(db, "user:2")))
    print("dbGet missing key = " + toString(dbGet(db, "no-such-key") == null))

    dbClose(db)
    print("Готово")
}
