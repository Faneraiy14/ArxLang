// ============================================================
// БУУТСТРАПІНГ: інтерпретатор підмножини NyxilumLang, написаний САМОЮ NyxilumLang.
// Лексер -> Парсер (AST як мапи) -> дерево-обхідний інтерпретатор.
// Підтримує: var, if/else, while, func/return, print, арифметику,
// порівняння, &&/||/!, виклики функцій (включно з рекурсією).
// НЕ підтримує (свідомо, для обсягу): масиви/структури/замикання
// у САМІЙ інтерпретованій мові (хоч сам інтерпретатор активно
// використовує масиви, мапи й функції-значення NyxilumLang).
// ============================================================

// ===== ЛЕКСЕР =====

func isDigit(c) {
    var code = charCode(c)
    return code >= 48 && code <= 57
}

func isAlpha(c) {
    var code = charCode(c)
    return (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code == 95
}

func isAlphaNum(c) {
    return isAlpha(c) || isDigit(c)
}

func isKeyword(word) {
    var keywords = ["var", "if", "else", "while", "func", "return", "print", "true", "false"]
    for kw in keywords {
        if kw == word {
            return true
        }
    }
    return false
}

func makeToken(type_, value) {
    var tok = newMap()
    mapSet(tok, "type", type_)
    mapSet(tok, "value", value)
    return tok
}

func tokenize(source) {
    var tokens = []
    var pos = 0
    var length = len(source)
    var twoCharOps = ["==", "!=", "<=", ">=", "&&", "||"]

    while pos < length {
        var c = substring(source, pos, 1)

        if c == " " || c == "\n" || c == "\r" || c == "\t" {
            pos = pos + 1
        } else if isDigit(c) {
            var num = ""
            while pos < length && isDigit(substring(source, pos, 1)) {
                num = num + substring(source, pos, 1)
                pos = pos + 1
            }
            append(tokens, makeToken("NUMBER", num))
        } else if isAlpha(c) {
            var word = ""
            while pos < length && isAlphaNum(substring(source, pos, 1)) {
                word = word + substring(source, pos, 1)
                pos = pos + 1
            }
            var tokType = "IDENT"
            if isKeyword(word) {
                tokType = "KEYWORD"
            }
            append(tokens, makeToken(tokType, word))
        } else if c == "\"" {
            pos = pos + 1
            var str = ""
            while pos < length && substring(source, pos, 1) != "\"" {
                str = str + substring(source, pos, 1)
                pos = pos + 1
            }
            pos = pos + 1
            append(tokens, makeToken("STRING", str))
        } else {
            var next = ""
            if pos + 1 < length {
                next = substring(source, pos + 1, 1)
            }
            var twoChar = c + next
            var matched = false
            for twoOp in twoCharOps {
                if twoOp == twoChar {
                    append(tokens, makeToken("OP", twoChar))
                    pos = pos + 2
                    matched = true
                }
            }
            if !matched {
                append(tokens, makeToken("OP", c))
                pos = pos + 1
            }
        }
    }

    append(tokens, makeToken("EOF", ""))
    return tokens
}

// ===== ПАРСЕР =====
// Стан парсера - мапа (посилальний тип у NyxilumLang), тож функції можуть
// ділити й оновлювати позицію без явного повернення "нового стану".

func makeParserState(tokens) {
    var state = newMap()
    mapSet(state, "tokens", tokens)
    mapSet(state, "pos", 0)
    return state
}

func peek(state) {
    var tokens = mapGet(state, "tokens")
    return tokens[mapGet(state, "pos")]
}

func advanceTok(state) {
    var tok = peek(state)
    mapSet(state, "pos", mapGet(state, "pos") + 1)
    return tok
}

func checkType(state, type_) {
    return mapGet(peek(state), "type") == type_
}

func checkValue(state, value) {
    return mapGet(peek(state), "value") == value
}

func makeNode(type_) {
    var n = newMap()
    mapSet(n, "type", type_)
    return n
}

func parsePrimary(state) {
    var tok = peek(state)
    var t = mapGet(tok, "type")
    var v = mapGet(tok, "value")

    if t == "NUMBER" {
        advanceTok(state)
        var n = makeNode("Literal")
        mapSet(n, "value", toDouble(v))
        return n
    }
    if t == "STRING" {
        advanceTok(state)
        var n = makeNode("Literal")
        mapSet(n, "value", v)
        return n
    }
    if t == "KEYWORD" && (v == "true" || v == "false") {
        advanceTok(state)
        var n = makeNode("Literal")
        mapSet(n, "value", v == "true")
        return n
    }
    if t == "IDENT" {
        advanceTok(state)
        if checkValue(state, "(") {
            advanceTok(state)
            var args = []
            while !checkValue(state, ")") {
                append(args, parseExpr(state))
                if checkValue(state, ",") {
                    advanceTok(state)
                }
            }
            advanceTok(state)
            var n = makeNode("Call")
            mapSet(n, "name", v)
            mapSet(n, "args", args)
            return n
        }
        var n = makeNode("Var")
        mapSet(n, "name", v)
        return n
    }
    if checkValue(state, "(") {
        advanceTok(state)
        var inner = parseExpr(state)
        advanceTok(state)
        return inner
    }
    throw "Неочікуваний токен: " + t + " '" + v + "'"
}

func parseUnary(state) {
    if checkValue(state, "!") || checkValue(state, "-") {
        var op = mapGet(advanceTok(state), "value")
        var operand = parseUnary(state)
        var n = makeNode("Unary")
        mapSet(n, "op", op)
        mapSet(n, "operand", operand)
        return n
    }
    return parsePrimary(state)
}

func parseBinaryLevel(state, ops, next) {
    var left = next(state)
    var found = true
    while found {
        found = false
        for op in ops {
            if checkValue(state, op) {
                advanceTok(state)
                var right = next(state)
                var n = makeNode("Binary")
                mapSet(n, "op", op)
                mapSet(n, "left", left)
                mapSet(n, "right", right)
                left = n
                found = true
            }
        }
    }
    return left
}

func parseMul(state) { return parseBinaryLevel(state, ["*", "/", "%"], parseUnary) }
func parseAdd(state) { return parseBinaryLevel(state, ["+", "-"], parseMul) }
func parseComparison(state) { return parseBinaryLevel(state, ["<", "<=", ">", ">="], parseAdd) }
func parseEquality(state) { return parseBinaryLevel(state, ["==", "!="], parseComparison) }
func parseAnd(state) { return parseBinaryLevel(state, ["&&"], parseEquality) }
func parseOr(state) { return parseBinaryLevel(state, ["||"], parseAnd) }

func parseExpr(state) {
    var startPos = mapGet(state, "pos")
    if checkType(state, "IDENT") {
        var name = mapGet(peek(state), "value")
        advanceTok(state)
        if checkValue(state, "=") {
            advanceTok(state)
            var value = parseExpr(state)
            var n = makeNode("Assign")
            mapSet(n, "name", name)
            mapSet(n, "value", value)
            return n
        }
        mapSet(state, "pos", startPos)
    }
    return parseOr(state)
}

func parseBlock(state) {
    advanceTok(state)
    var stmts = []
    while !checkValue(state, "}") {
        append(stmts, parseStatement(state))
    }
    advanceTok(state)
    return stmts
}

func parseStatement(state) {
    var tok = peek(state)
    var t = mapGet(tok, "type")
    var v = mapGet(tok, "value")

    if t == "KEYWORD" && v == "var" {
        advanceTok(state)
        var name = mapGet(advanceTok(state), "value")
        advanceTok(state)
        var init = parseExpr(state)
        var n = makeNode("VarDecl")
        mapSet(n, "name", name)
        mapSet(n, "init", init)
        return n
    }
    if t == "KEYWORD" && v == "if" {
        advanceTok(state)
        advanceTok(state)
        var cond = parseExpr(state)
        advanceTok(state)
        var thenBlock = parseBlock(state)
        var elseBlock = []
        if checkType(state, "KEYWORD") && checkValue(state, "else") {
            advanceTok(state)
            elseBlock = parseBlock(state)
        }
        var n = makeNode("If")
        mapSet(n, "cond", cond)
        mapSet(n, "then", thenBlock)
        mapSet(n, "else", elseBlock)
        return n
    }
    if t == "KEYWORD" && v == "while" {
        advanceTok(state)
        advanceTok(state)
        var cond = parseExpr(state)
        advanceTok(state)
        var body = parseBlock(state)
        var n = makeNode("While")
        mapSet(n, "cond", cond)
        mapSet(n, "body", body)
        return n
    }
    if t == "KEYWORD" && v == "func" {
        advanceTok(state)
        var name = mapGet(advanceTok(state), "value")
        advanceTok(state)
        var params = []
        while !checkValue(state, ")") {
            append(params, mapGet(advanceTok(state), "value"))
            if checkValue(state, ",") {
                advanceTok(state)
            }
        }
        advanceTok(state)
        var body = parseBlock(state)
        var n = makeNode("FuncDecl")
        mapSet(n, "name", name)
        mapSet(n, "params", params)
        mapSet(n, "body", body)
        return n
    }
    if t == "KEYWORD" && v == "return" {
        advanceTok(state)
        var value = parseExpr(state)
        var n = makeNode("Return")
        mapSet(n, "value", value)
        return n
    }
    if t == "KEYWORD" && v == "print" {
        advanceTok(state)
        advanceTok(state)
        var value = parseExpr(state)
        advanceTok(state)
        var n = makeNode("Print")
        mapSet(n, "value", value)
        return n
    }

    var expr = parseExpr(state)
    var n = makeNode("ExprStmt")
    mapSet(n, "expr", expr)
    return n
}

func parseProgram(tokens) {
    var state = makeParserState(tokens)
    var stmts = []
    while !checkType(state, "EOF") {
        append(stmts, parseStatement(state))
    }
    return stmts
}

// ===== ІНТЕРПРЕТАТОР =====

func evalExpr(node, env, functions) {
    var t = mapGet(node, "type")

    if t == "Literal" {
        return mapGet(node, "value")
    }
    if t == "Var" {
        return mapGet(env, mapGet(node, "name"))
    }
    if t == "Assign" {
        var value = evalExpr(mapGet(node, "value"), env, functions)
        mapSet(env, mapGet(node, "name"), value)
        return value
    }
    if t == "Unary" {
        var operand = evalExpr(mapGet(node, "operand"), env, functions)
        if mapGet(node, "op") == "-" {
            return 0 - operand
        }
        return !operand
    }
    if t == "Binary" {
        var op = mapGet(node, "op")
        var left = evalExpr(mapGet(node, "left"), env, functions)

        if op == "&&" {
            if !left { return false }
            return evalExpr(mapGet(node, "right"), env, functions)
        }
        if op == "||" {
            if left { return true }
            return evalExpr(mapGet(node, "right"), env, functions)
        }

        var right = evalExpr(mapGet(node, "right"), env, functions)

        if op == "+" { return left + right }
        if op == "-" { return left - right }
        if op == "*" { return left * right }
        if op == "/" { return left / right }
        if op == "%" { return left % right }
        if op == "==" { return left == right }
        if op == "!=" { return left != right }
        if op == "<" { return left < right }
        if op == "<=" { return left <= right }
        if op == ">" { return left > right }
        if op == ">=" { return left >= right }

        throw "Невідомий оператор: " + op
    }
    if t == "Call" {
        var argNodes = mapGet(node, "args")
        var args = []
        for argNode in argNodes {
            append(args, evalExpr(argNode, env, functions))
        }
        return callFunction(mapGet(node, "name"), args, functions)
    }

    throw "Невідомий тип вузла: " + t
}

func execBlock(stmts, env, functions) {
    for stmt in stmts {
        execStatement(stmt, env, functions)
    }
}

func execStatement(node, env, functions) {
    var t = mapGet(node, "type")

    if t == "VarDecl" {
        mapSet(env, mapGet(node, "name"), evalExpr(mapGet(node, "init"), env, functions))
    } else if t == "Print" {
        print(evalExpr(mapGet(node, "value"), env, functions))
    } else if t == "ExprStmt" {
        evalExpr(mapGet(node, "expr"), env, functions)
    } else if t == "If" {
        if evalExpr(mapGet(node, "cond"), env, functions) {
            execBlock(mapGet(node, "then"), env, functions)
        } else {
            execBlock(mapGet(node, "else"), env, functions)
        }
    } else if t == "While" {
        while evalExpr(mapGet(node, "cond"), env, functions) {
            execBlock(mapGet(node, "body"), env, functions)
        }
    } else if t == "Return" {
        throw evalExpr(mapGet(node, "value"), env, functions)
    } else if t == "FuncDecl" {
        // нічого - вже зареєстровано в registerFunctions
    } else {
        throw "Невідомий тип оператора: " + t
    }
}

func registerFunctions(program, functions) {
    for stmt in program {
        if mapGet(stmt, "type") == "FuncDecl" {
            mapSet(functions, mapGet(stmt, "name"), stmt)
        }
    }
}

func callFunction(name, args, functions) {
    var funcNode = mapGet(functions, name)
    var env = newMap()
    var params = mapGet(funcNode, "params")
    var i = 0
    while i < len(params) {
        mapSet(env, params[i], args[i])
        i = i + 1
    }

    try {
        execBlock(mapGet(funcNode, "body"), env, functions)
        return null
    } catch (retVal) {
        return retVal
    }
}

func runProgram(source) {
    var tokens = tokenize(source)
    var program = parseProgram(tokens)

    var functions = newMap()
    registerFunctions(program, functions)

    var globalEnv = newMap()
    for stmt in program {
        if mapGet(stmt, "type") != "FuncDecl" {
            execStatement(stmt, globalEnv, functions)
        }
    }
}

// ===== ДЕМО: ЗАПУСКАЄМО ІНТЕРПРЕТОВАНУ ПРОГРАМУ =====

func main() {
    print("=== Буутстрапінг: інтерпретатор NyxilumLang, написаний на NyxilumLang ===")
    print("")

    var source = "func factorial(n) { if (n <= 1) { return 1 } return n * factorial(n - 1) } func fib(n) { if (n <= 1) { return n } return fib(n - 1) + fib(n - 2) } print(factorial(5)) print(factorial(10)) var i = 0 while (i < 8) { print(fib(i)) i = i + 1 } var sum = 0 var j = 1 while (j <= 100) { sum = sum + j j = j + 1 } print(sum)"

    print("Виконую інтерпретовану програму (factorial, fibonacci, сума 1..100):")
    runProgram(source)

    print("")
    print("=== Буутстрапінг успішний: інтерпретатор виконав рекурсію, цикли, умови ===")
}
