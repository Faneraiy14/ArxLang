{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ArxLang",
  "scopeName": "source.arxlang",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#types" },
    { "include": "#struct-literal" },
    { "include": "#function-call" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.arxlang",
          "match": "//.*$"
        },
        {
          "name": "comment.block.arxlang",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.arxlang",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.arxlang",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.arxlang",
      "match": "\\b\\d+(\\.\\d+)?\\b"
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.arxlang",
          "match": "\\b(if|else|while|for|in|return|break|continue|try|catch|throw|import)\\b"
        },
        {
          "name": "storage.type.arxlang",
          "match": "\\b(func|var|struct)\\b"
        },
        {
          "name": "variable.language.self.arxlang",
          "match": "\\bself\\b"
        }
      ]
    },
    "constants": {
      "name": "constant.language.arxlang",
      "match": "\\b(true|false|null)\\b"
    },
    "types": {
      "name": "support.type.arxlang",
      "match": "\\b(i32|f64|string|bool)\\b"
    },
    "struct-literal": {
      "name": "entity.name.type.arxlang",
      "match": "\\b([A-ZА-ЯЇІЄҐ][A-Za-zА-Яа-яЇїІіЄєҐґ0-9_]*)\\s*(?=\\{)"
    },
    "function-call": {
      "match": "\\b([A-Za-zА-Яа-яЇїІіЄєҐґ_][A-Za-zА-Яа-яЇїІіЄєҐґ0-9_]*)\\s*(?=\\()",
      "name": "entity.name.function.arxlang"
    },
    "operators": {
      "name": "keyword.operator.arxlang",
      "match": "(\\+|-|\\*|/|%|==|!=|<=|>=|<|>|&&|\\|\\||!|=|\\.\\.)"
    }
  }
}
