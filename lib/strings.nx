// lib/strings.nx — рядкові утиліти понад вбудовані substring/trim/split/
// join/indexOf/toUpper/toLower (у дусі методів Python str / lodash).

func capitalize(s) {
    if len(s) == 0 {
        return s
    }
    return toUpper(substring(s, 0, 1)) + substring(s, 1, len(s) - 1)
}

func titleCase(s) {
    var words = split(s, " ")
    var result = []
    var i = 0
    while i < len(words) {
        append(result, capitalize(words[i]))
        i = i + 1
    }
    return join(result, " ")
}

func isBlank(s) {
    return trim(s) == ""
}

func isEmpty(s) {
    return len(s) == 0
}

func padLeft(s, length, padChar) {
    var result = s
    while len(result) < length {
        result = padChar + result
    }
    return result
}

func padRight(s, length, padChar) {
    var result = s
    while len(result) < length {
        result = result + padChar
    }
    return result
}

// Кількість НЕперетинних входжень sub у s (як Python str.count) - "aaa"
// з sub="aa" дає 1, а не 2.
func countOccurrences(s, sub) {
    if len(sub) == 0 {
        return 0
    }
    var count = 0
    var remaining = s
    var pos = indexOf(remaining, sub)
    while pos != -1 {
        count = count + 1
        remaining = substring(remaining, pos + len(sub), len(remaining) - pos - len(sub))
        pos = indexOf(remaining, sub)
    }
    return count
}
