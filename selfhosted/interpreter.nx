// ============================================================
// ІНТЕРПРЕТАТОР — дерево-обхідне виконання AST.
// Значення масивів/чисел/рядків/bool - напряму значення хоста NyxilumLang.
// "Об'єкт структури" і "функція-значення" - мапи (NxMap) з міткою-полем.
// Середовище (env) - ланцюжок мап {__vars, __parent} => справжні лексичні
// замикання зі спільним мутабельним станом (env - посилальний тип).
// Невідомі виклики (не user-функція, не метод) делегуються нативному
// реєстру хоста через callWithArgs - так підмножина мови отримує доступ
// до ВСІХ вбудованих можливостей NyxilumLang (математика, рядки, файли,
// HTTP, графіка) без переписування їх самих.
// ============================================================

// ===== СЕРЕДОВИЩЕ =====

func newEnv(parent) {
    var env = newMap()
    mapSet(env, "__parent", parent)
    mapSet(env, "__vars", newMap())
    return env
}

func envGetOwner(env, name) {
    if env == null {
        return null
    }
    var vars = mapGet(env, "__vars")
    if mapHas(vars, name) {
        return env
    }
    return envGetOwner(mapGet(env, "__parent"), name)
}

func envHas(env, name) {
    return envGetOwner(env, name) != null
}

func envGet(env, name) {
    var owner = envGetOwner(env, name)
    if owner == null {
        throw "Змінна '" + name + "' не оголошена"
    }
    return mapGet(mapGet(owner, "__vars"), name)
}

func envDefine(env, name, value) {
    mapSet(mapGet(env, "__vars"), name, value)
}

func envAssign(env, name, value) {
    var owner = envGetOwner(env, name)
    if owner == null {
        throw "Змінна '" + name + "' не оголошена"
    }
    mapSet(mapGet(owner, "__vars"), name, value)
}

// ===== НАТИВНИЙ РЕЄСТР (делегування до хоста NyxilumLang) =====

func buildNativeRegistry() {
    var reg = newMap()
    mapSet(reg, "sqrt", sqrt)
    mapSet(reg, "abs", abs)
    mapSet(reg, "pow", pow)
    mapSet(reg, "sin", sin)
    mapSet(reg, "cos", cos)
    mapSet(reg, "round", round)
    mapSet(reg, "floor", floor)
    mapSet(reg, "ceil", ceil)
    mapSet(reg, "max", max)
    mapSet(reg, "min", min)
    mapSet(reg, "toString", toString)
    mapSet(reg, "toInt", toInt)
    mapSet(reg, "toDouble", toDouble)
    mapSet(reg, "typeOf", typeOf)
    mapSet(reg, "charCode", charCode)
    mapSet(reg, "fromCharCode", fromCharCode)
    mapSet(reg, "isNull", isNull)
    mapSet(reg, "len", len)
    mapSet(reg, "substring", substring)
    mapSet(reg, "toUpper", toUpper)
    mapSet(reg, "toLower", toLower)
    mapSet(reg, "contains", contains)
    mapSet(reg, "split", split)
    mapSet(reg, "join", join)
    mapSet(reg, "append", append)
    mapSet(reg, "pop", pop)
    mapSet(reg, "readFile", readFile)
    mapSet(reg, "writeFile", writeFile)
    mapSet(reg, "fileExists", fileExists)
    mapSet(reg, "now", now)
    mapSet(reg, "randomInt", randomInt)
    mapSet(reg, "newMap", newMap)
    mapSet(reg, "mapSet", mapSet)
    mapSet(reg, "mapGet", mapGet)
    mapSet(reg, "mapHas", mapHas)
    mapSet(reg, "mapKeys", mapKeys)
    mapSet(reg, "toJson", toJson)
    mapSet(reg, "fromJson", fromJson)
    mapSet(reg, "sleep", sleep)
    mapSet(reg, "httpGet", httpGet)
    mapSet(reg, "urlStatus", urlStatus)
    mapSet(reg, "osPlatform", osPlatform)
    mapSet(reg, "createCanvas", createCanvas)
    mapSet(reg, "clearCanvas", clearCanvas)
    mapSet(reg, "drawRect", drawRect)
    mapSet(reg, "drawCircle", drawCircle)
    mapSet(reg, "drawLine", drawLine)
    mapSet(reg, "drawText", drawText)
    mapSet(reg, "presentCanvas", presentCanvas)
    mapSet(reg, "canvasShouldClose", canvasShouldClose)
    mapSet(reg, "closeCanvas", closeCanvas)
    mapSet(reg, "isKeyDown", isKeyDown)
    return reg
}

// ===== ВИКЛИКИ ФУНКЦІЙ =====
// "return" реалізовано через throw/try - НАТИВНИЙ throw/try хоста NyxilumLang,
// а не самостійно написаний механізм: guest-return піднімається як
// host-виняток до найближчого callNamedFunction/callFunctionValue.
//
// Значення return загортається в маркер-мапу. Без цього catch ловив БУДЬ-ЯКУ
// помилку ("Змінна не оголошена", "Функція не знайдена") і тихо повертав її
// як результат функції - тому будь-яка помилка в гостьовій програмі виглядала
// як "нічого не сталось", без жодного повідомлення.

func makeReturn(value) {
    var box = newMap()
    mapSet(box, "__isReturn", true)
    mapSet(box, "value", value)
    return box
}

func isReturnBox(v) {
    if typeOf(v) != "map" {
        return false
    }
    return mapHas(v, "__isReturn")
}

// Спільна обробка результату try/catch для обох видів виклику: свій return
// розпаковуємо, чужу помилку кидаємо далі, щоб вона дійшла до користувача.
func unwrapReturn(caught) {
    if isReturnBox(caught) {
        return mapGet(caught, "value")
    }
    throw caught
}

func callNamedFunction(funcNode, args, functions, natives) {
    var callEnv = newEnv(null)
    var params = mapGet(funcNode, "params")
    var i = 0
    while i < len(params) {
        envDefine(callEnv, params[i], args[i])
        i = i + 1
    }
    try {
        execBlock(mapGet(funcNode, "body"), callEnv, functions, natives)
        return null
    } catch (caught) {
        return unwrapReturn(caught)
    }
}

func callFunctionValue(fnValue, args, functions, natives) {
    var closureEnv = mapGet(fnValue, "closureEnv")
    var callEnv = newEnv(closureEnv)
    var params = mapGet(fnValue, "params")
    var i = 0
    while i < len(params) {
        envDefine(callEnv, params[i], args[i])
        i = i + 1
    }
    try {
        execBlock(mapGet(fnValue, "body"), callEnv, functions, natives)
        return null
    } catch (caught) {
        return unwrapReturn(caught)
    }
}

func isFunctionValue(v) {
    return typeOf(v) == "map" && mapHas(v, "__isFunc")
}

// ===== ВИРАЗИ =====

func evalExpr(node, env, functions, natives) {
    var t = mapGet(node, "type")

    if t == "Literal" {
        return mapGet(node, "value")
    }
    if t == "Var" {
        return envGet(env, mapGet(node, "name"))
    }
    if t == "Unary" {
        var operand = evalExpr(mapGet(node, "operand"), env, functions, natives)
        if mapGet(node, "op") == "-" {
            return 0 - operand
        }
        return !operand
    }
    if t == "Binary" {
        var op = mapGet(node, "op")
        var left = evalExpr(mapGet(node, "left"), env, functions, natives)
        if op == "&&" {
            if !left { return false }
            return evalExpr(mapGet(node, "right"), env, functions, natives)
        }
        if op == "||" {
            if left { return true }
            return evalExpr(mapGet(node, "right"), env, functions, natives)
        }
        var right = evalExpr(mapGet(node, "right"), env, functions, natives)
        if op == "+" { return left + right }
        if op == "-" { return left - right }
        if op == "*" { return left * right }
        if op == "/" { return left / right }
        if op == "%" { return left % right }
        if op == "==" { return left == right }
        if op == "!=" { return left != right }
        if op == "<" { return left < right }
        if op == "<=" { return left <= right }
        if op == ">" { return left > right }
        if op == ">=" { return left >= right }
        throw "Невідомий оператор: " + op
    }
    if t == "ArrayLiteral" {
        var arr = []
        var elems = mapGet(node, "elements")
        for e in elems {
            append(arr, evalExpr(e, env, functions, natives))
        }
        return arr
    }
    if t == "Index" {
        var arr = evalExpr(mapGet(node, "arr"), env, functions, natives)
        var idx = evalExpr(mapGet(node, "index"), env, functions, natives)
        return arr[idx]
    }
    if t == "FunctionExpr" {
        var fv = newMap()
        mapSet(fv, "__isFunc", true)
        mapSet(fv, "params", mapGet(node, "params"))
        mapSet(fv, "body", mapGet(node, "body"))
        mapSet(fv, "closureEnv", env)
        return fv
    }
    if t == "StructInit" {
        var inst = newMap()
        mapSet(inst, "__structType", mapGet(node, "structName"))
        var fields = mapGet(node, "fields")
        for f in fields {
            mapSet(inst, mapGet(f, "name"), evalExpr(mapGet(f, "value"), env, functions, natives))
        }
        return inst
    }
    if t == "Member" {
        var obj = evalExpr(mapGet(node, "obj"), env, functions, natives)
        return mapGet(obj, mapGet(node, "field"))
    }
    if t == "Assign" {
        var value = evalExpr(mapGet(node, "value"), env, functions, natives)
        var target = mapGet(node, "target")
        var tt = mapGet(target, "type")
        if tt == "Var" {
            envAssign(env, mapGet(target, "name"), value)
        } else if tt == "Index" {
            var arr = evalExpr(mapGet(target, "arr"), env, functions, natives)
            var idx = evalExpr(mapGet(target, "index"), env, functions, natives)
            arr[idx] = value
        } else if tt == "Member" {
            var obj = evalExpr(mapGet(target, "obj"), env, functions, natives)
            mapSet(obj, mapGet(target, "field"), value)
        }
        return value
    }
    if t == "Call" {
        var name = mapGet(node, "name")
        var argNodes = mapGet(node, "args")
        var args = []
        var argI = 0
        while argI < len(argNodes) {
            append(args, evalExpr(argNodes[argI], env, functions, natives))
            argI = argI + 1
        }

        if envHas(env, name) {
            var maybeFn = envGet(env, name)
            if isFunctionValue(maybeFn) {
                return callFunctionValue(maybeFn, args, functions, natives)
            }
        }
        if mapHas(functions, name) {
            return callNamedFunction(mapGet(functions, name), args, functions, natives)
        }
        if mapHas(natives, name) {
            return callWithArgs(mapGet(natives, name), args)
        }
        throw "Функція '" + name + "' не знайдена"
    }
    if t == "MethodCall" {
        var obj = evalExpr(mapGet(node, "obj"), env, functions, natives)
        var methodName = mapGet(node, "method")
        var argNodes = mapGet(node, "args")
        var args = [obj]
        for a in argNodes {
            append(args, evalExpr(a, env, functions, natives))
        }
        var structType = mapGet(obj, "__structType")
        var fullName = structType + "." + methodName
        if !mapHas(functions, fullName) {
            throw "Метод '" + methodName + "' не знайдено у '" + structType + "'"
        }
        return callNamedFunction(mapGet(functions, fullName), args, functions, natives)
    }

    throw "Невідомий тип вузла: " + t
}

// ===== ОПЕРАТОРИ =====

func execBlock(stmts, env, functions, natives) {
    for stmt in stmts {
        execStatement(stmt, env, functions, natives)
    }
}

func execStatement(node, env, functions, natives) {
    var t = mapGet(node, "type")

    if t == "VarDecl" {
        envDefine(env, mapGet(node, "name"), evalExpr(mapGet(node, "init"), env, functions, natives))
    } else if t == "Print" {
        print(evalExpr(mapGet(node, "value"), env, functions, natives))
    } else if t == "ExprStmt" {
        evalExpr(mapGet(node, "expr"), env, functions, natives)
    } else if t == "If" {
        if evalExpr(mapGet(node, "cond"), env, functions, natives) {
            execBlock(mapGet(node, "then"), newEnv(env), functions, natives)
        } else {
            execBlock(mapGet(node, "else"), newEnv(env), functions, natives)
        }
    } else if t == "While" {
        while evalExpr(mapGet(node, "cond"), env, functions, natives) {
            execBlock(mapGet(node, "body"), newEnv(env), functions, natives)
        }
    } else if t == "ForRange" {
        var i = evalExpr(mapGet(node, "start"), env, functions, natives)
        var endVal = evalExpr(mapGet(node, "end"), env, functions, natives)
        while i < endVal {
            var loopEnv = newEnv(env)
            envDefine(loopEnv, mapGet(node, "varName"), i)
            execBlock(mapGet(node, "body"), loopEnv, functions, natives)
            i = i + 1
        }
    } else if t == "ForEach" {
        var arr = evalExpr(mapGet(node, "arrExpr"), env, functions, natives)
        var i = 0
        while i < len(arr) {
            var loopEnv = newEnv(env)
            envDefine(loopEnv, mapGet(node, "varName"), arr[i])
            execBlock(mapGet(node, "body"), loopEnv, functions, natives)
            i = i + 1
        }
    } else if t == "Return" {
        throw makeReturn(evalExpr(mapGet(node, "value"), env, functions, natives))
    } else if t == "FuncDecl" {
        // вже зареєстровано в registerDecls
    } else if t == "StructDecl" {
        // вже зареєстровано в registerDecls
    } else {
        throw "Невідомий тип оператора: " + t
    }
}

// ===== ЗАПУСК ПРОГРАМИ =====

func registerDecls(program, functions) {
    for stmt in program {
        var t = mapGet(stmt, "type")
        if t == "FuncDecl" {
            var name = mapGet(stmt, "name")
            var structName = mapGet(stmt, "structName")
            if structName != null {
                name = structName + "." + name
            }
            mapSet(functions, name, stmt)
        }
    }
}

func runProgram(source) {
    var tokens = tokenize(source)
    var program = parseProgram(tokens)

    var functions = newMap()
    registerDecls(program, functions)

    var natives = buildNativeRegistry()
    var globalEnv = newEnv(null)

    for stmt in program {
        var t = mapGet(stmt, "type")
        if t != "FuncDecl" && t != "StructDecl" {
            execStatement(stmt, globalEnv, functions, natives)
        }
    }
}
