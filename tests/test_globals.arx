// Глобальні var (верхній рівень файлу) — раніше функції їх взагалі не
// бачили: CompileFunctions компілює ВСІ тіла функцій ОДНИМ проходом, який
// завжди відбувається РАНІШЕ, ніж top-level var, незалежно від текстового
// порядку в файлі. Виправлено через окреме сховище GET_GLOBAL/SET_GLOBAL
// за іменем.
//
// Заодно тут перевіряється сусідній фікс: явний виклик іменованої функції
// З КОДУ ВЕРХНЬОГО РІВНЯ раніше зациклював програму навіки (адреса виклику
// патчилась ДО того, як цей самий виклик узагалі компілювався).

var МАКС = 100

func читає() {
    return МАКС
}

func пише() {
    МАКС = 555
}

func main() {
    print("1. функція бачить глобальну, оголошену РАНІШЕ в тексті")
    if читає() == 100 { print("  ок") } else { print("  ПРОВАЛ") }

    print("2. запис у глобальну з функції видно назовні")
    пише()
    if МАКС == 555 { print("  ок") } else { print("  ПРОВАЛ") }

    print("3. локальна var з тим самим іменем не плутається з глобальною")
    var МАКС = 1
    if МАКС == 1 { print("  ок") } else { print("  ПРОВАЛ") }
}

// Функція, оголошена ПІСЛЯ головного тесту вище, — той самий пре-прохід
// має зареєструвати ім'я глобальної незалежно від порядку.
func ще() {
    return МАКС
}

main()

print("4. явний виклик функції верхнього рівня (main() вище) не зациклив програму")
print("  ок")

print("5. глобальна, змінена всередині main, видна й тут")
if МАКС == 555 { print("  ок") } else { print("  ПРОВАЛ") }

print("ГОТОВО")
