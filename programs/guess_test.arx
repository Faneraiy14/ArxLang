// Вгадай число v2.0 — версія з рівнями складності.
//
// Що виправлено проти першого варіанта:
//   * межі рівня зберігаються у змінних, а не дублюються в кожній гілці —
//     раніше randomInt і текст підказки писались тричі майже однаково;
//   * загадане число більше не генерується двічі (спершу в main, потім у
//     гілці) — зайвий randomInt на початку прибрано;
//   * підказка "більше/менше" тепер з погляду ГРАВЦЯ: якщо його число
//     завелике, він має вводити менше;
//   * додано лічильник спроб і оптимальну кількість для порівняння;
//   * рівень 3 порівнював загадане число із жорстко вбитим 75 замість
//     введеного гравцем числа — підказка не залежала від того, що
//     вводиш, і завжди була та сама. Тепер рівень 3 працює як рівень 2
//     (більше/менше відносно РЕАЛЬНОГО загаданого), лише з ширшим
//     діапазоном (1-150 замість 1-100);
//   * додано рівні 5-7 (число від 1 до 100 для всіх трьох):
//     - 5 "На виживання" — звичайне більше/менше, але лише 7 спроб
//       (= оптимум(100), без права на жодну зайву);
//     - 6 "Брехунець" — більше/менше, але з шансом 1 з 4 показує
//       протилежне до правди;
//     - 7 "Тепліше/Холодніше" — без напрямку взагалі, лише тренд
//       відстані відносно попередньої спроби.

func опис(рівень) {
    if рівень == 1 {
        return "Легкий: показує різницю, число від 1 до 50"
    } else if рівень == 2 {
        return "Середній: тільки більше/менше, число від 1 до 100"
    } else if рівень == 3 {
        return "Складний: тільки більше/менше, число від 1 до 150"
    } else if рівень == 4 {
        return "Дуже складний: без підказок, число від 1 до 200"
    } else if рівень == 5 {
        return "На виживання: більше/менше, але лише " + максСпроб(5) + " спроб, число від 1 до 100"
    } else if рівень == 6 {
        return "Брехунець: більше/менше, але підказка інколи бреше, число від 1 до 100"
    }
    return "Тепліше/Холодніше: жодного більше/менше, лише тренд відносно попередньої спроби, число від 1 до 100"
}

func межа(рівень) {
    if рівень == 1 {
        return 50
    } else if рівень == 2 {
        return 100
    } else if рівень == 3 {
        return 150
    } else if рівень == 4 {
        return 200
    }
    return 100
}

// Ліміт спроб для рівня 5 — навмисно точно оптимум(100), щоб зіграти
// ідеальною стратегією половинного ділення можна було впритул, без
// жодної зайвої спроби.
func максСпроб(рівень) {
    if рівень == 5 {
        return 7
    }
    return 999999
}

// Скільки спроб потрібно ідеальній стратегії (діленню навпіл) у найгіршому
// випадку: найменше k, за якого 2^k >= межа. Рахуємо подвоєнням, а не
// діленням: ділення в ArxLang дробове, і лічильник накручував зайвий крок.
func оптимум(межа) {
    var кроків = 0
    var діапазон = 1
    while діапазон < межа {
        діапазон = діапазон * 2
        кроків = кроків + 1
    }
    return кроків
}

func підказка(загадане, введене, рівень) {
    if рівень == 4 {
        return "Не те. Спробуй ще."
    }

    // Рівень 3 — комбінована підказка від фіксованого орієнтира 75
    // (середина діапазону 1-150): спершу кажемо, чи твоє число й загадане
    // по один бік від 75, чи по різні, а тоді все одно даємо звичайне
    // більше/менше відносно РЕАЛЬНОГО загаданого — без цього гру
    // неможливо було б розв'язати.
    if рівень == 3 {
        var бікВведеного = введене > 75
        var бікЗагаданого = загадане > 75
        var сторона = "Ти і загадане по один бік від 75. "
        if бікВведеного != бікЗагаданого {
            сторона = "Ти і загадане по різні боки від 75. "
        }

        if введене > загадане {
            return сторона + "Забагато. Бери менше."
        }
        return сторона + "Замало. Бери більше."
    }

    // Рівень 6 — "Брехунець": звичайна підказка більше/менше, але з
    // шансом 1 з 4 показує ПРОТИЛЕЖНЕ до правди. Довіряти одній окремій
    // підказці не можна — треба повторювати близькі числа й дивитись,
    // яка версія збігається частіше.
    if рівень == 6 {
        var введенеЗавелике = введене > загадане
        if randomInt(1, 4) == 1 {
            введенеЗавелике = !введенеЗавелике
        }
        if введенеЗавелике {
            return "Забагато. Бери менше."
        }
        return "Замало. Бери більше."
    }

    if введене > загадане {
        if рівень == 1 {
            return "Забагато на " + (введене - загадане) + ". Бери менше."
        }
        return "Забагато. Бери менше."
    }

    if рівень == 1 {
        return "Замало на " + (загадане - введене) + ". Бери більше."
    }
    return "Замало. Бери більше."
}

func грати(рівень) {
    var верх = межа(рівень)
    var загадане = randomInt(1, верх)
    var спроби = 0
    // Для рівня 7 — відстань до загаданого на попередній спробі.
    // -1 означає "спроб ще не було", окремий випадок без тренду.
    var попереднєВідстань = -1

    print("")
    print("Вгадай число від 1 до " + верх + ".")
    if рівень == 5 {
        print("У тебе лише " + максСпроб(5) + " спроб.")
    }

    while true {
        var введене = readInt()
        спроби = спроби + 1

        if введене < 1 || введене > верх {
            print("Число має бути від 1 до " + верх + ". Ця спроба не рахується.")
            спроби = спроби - 1
        } else if введене == загадане {
            print("")
            print("Вгадав! Число було " + загадане + ".")
            print("Спроб: " + спроби + ". Оптимально можна було за " + оптимум(верх) + ".")
            break
        } else if рівень == 5 && спроби >= максСпроб(рівень) {
            print("")
            print(підказка(загадане, введене, рівень))
            print("Спроби закінчились. Загадане було " + загадане + ". Ти програв.")
            break
        } else if рівень == 5 {
            print(підказка(загадане, введене, рівень) + " (залишилось спроб: " + (максСпроб(5) - спроби) + ")")
        } else if рівень == 7 {
            var відстань = abs(введене - загадане)
            if попереднєВідстань == -1 {
                print("Запам'ятав. Пробуй ще.")
            } else if відстань < попереднєВідстань {
                print("Тепліше!")
            } else if відстань > попереднєВідстань {
                print("Холодніше!")
            } else {
                print("Так само, як і минулого разу.")
            }
            попереднєВідстань = відстань
        } else {
            print(підказка(загадане, введене, рівень))
        }
    }
}

func main() {
    print("=== Вгадай число v2.0 ===")
    print("")
    print("1 - " + опис(1))
    print("2 - " + опис(2))
    print("3 - " + опис(3))
    print("4 - " + опис(4))
    print("5 - " + опис(5))
    print("6 - " + опис(6))
    print("7 - " + опис(7))
    print("")
    print("Обери рівень:")

    var рівень = readInt()

    if рівень != 1 && рівень != 2 && рівень != 3 && рівень != 4 && рівень != 5 && рівень != 6 && рівень != 7 {
        print("Такого рівня немає. Граємо на 2.")
        рівень = 2
    }

    грати(рівень)
}